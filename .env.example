# Example artifact configuration.
# IMPORTANT: Use trusted release mirrors and REAL SHA-256 hashes.
# Do not commit this file with secrets.

PORT=8787
COD4X_INSTALL_ROOT=./installations

COD4X_212_URL=
COD4X_212_SHA256=
COD4X_213_URL=
COD4X_213_SHA256=
COD4X_214_URL=
