PROMOD_CUSTOM_URL=
PROMOD_CUSTOM_SHA256=

# FPSChallenge.eu 2.85 is hosted at dl.fpschallenge.eu. The public index does not publish a SHA-256.
# Safer: set FPS_285_SHA256 yourself after independently obtaining/verifying the digest.
# Explicit opt-in (less strict):
ALLOW_FPSCHALLENGE_UNSIGNED=false

# Anti-cheat profiles are configuration profiles. No proprietary RUSCOD variables are guessed.

# FPSChallenge.eu Anti-Cheat
FPSAC_SHA256=
ALLOW_FPSAC_UNSIGNED=false

# Optional verified RusCOD anti-cheat package
RUSCOD_AC_URL=
RUSCOD_AC_SHA256=
RUSCOD_AC_HOST=

# Optional FPSAC 9.2.0 verified artifact; checksum is required for installer-managed files.
FPSAC_URL=
