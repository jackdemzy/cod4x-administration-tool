{
  "name": "cod4x-control-installer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node installer-server.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "preflight": "node scripts/preflight-4.18.14.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tar": "^7.4.3"
  },
  "version": "4.18.14",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@vitejs/plugin-react": "~6.1.2",
    "electron": "^42.11.16",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "eu.cod4x.control",
    "productName": "COD4X CONTROL",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "installer-server.mjs",
      "lib/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "COD4X-CONTROL-Setup-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "license": "LICENSE"
    },
    "artifactName": "COD4X-CONTROL-Setup-${version}-${arch}.exe"
  },
  "main": "electron-main.cjs",
  "description": "COD4X CONTROL — Windows and Linux Dedicated Server runtime with verified process lifecycle controls.",
  "author": "COD4X CONTROL"
}
